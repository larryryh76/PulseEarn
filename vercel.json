{
  "version": 2,
  "redirects": [
    { "source": "/prediction", "destination": "/predictions", "permanent": true },
    { "source": "/profile", "destination": "/me", "permanent": true },
    { "source": "/referral", "destination": "/referrals", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/upload", "destination": "/api/upload.py" },
    { "source": "/((?!api|assets|favicon|icons|og-image|robots|sitemap|.*\\.).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*).xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" }
      ]
    }
  ]
}

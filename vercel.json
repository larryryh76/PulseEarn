{
  "version": 2,
  "redirects": [
    {
      "source": "/prediction",
      "destination": "/predictions",
      "permanent": true
    },
    {
      "source": "/profile",
      "destination": "/me",
      "permanent": true
    },
    {
      "source": "/referral",
      "destination": "/referrals",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(favicon.svg|icons.svg|og-image.png|robots.txt|sitemap.xml|sitemap_index.xml)",
      "destination": "/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/((?!api|favicon.svg|icons.svg|og-image.png|robots.txt|sitemap.xml|sitemap_index.xml|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*).xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        }
      ]
    }
  ]
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile images
    match /users/{userId}/avatars/{allPaths=**} {
      allow read: if isAuthenticated();
      allow create, update: if (isOwner(userId) || isAdmin()) && request.resource.size < 2 * 1024 * 1024;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Support ticket attachments
    match /support_tickets/{ticketId}/{allPaths=**} {
      allow read: if isAuthenticated() && (
        firestore.get(/databases/(default)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAuthenticated() && (
        firestore.get(/databases/(default)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid ||
        isAdmin()
      ) && request.resource.size < 5 * 1024 * 1024;
    }

    // Task submission proof
    match /task_claims/{claimId}/{allPaths=**} {
      allow read: if isAdmin() || (
        isAuthenticated() &&
        firestore.get(/databases/(default)/documents/task_claims/$(claimId)).data.userId == request.auth.uid
      );
      allow write: if isAuthenticated() && (
        firestore.get(/databases/(default)/documents/task_claims/$(claimId)).data.userId == request.auth.uid ||
        isAdmin()
      ) && request.resource.size < 5 * 1024 * 1024;
    }

    // Campaign assets (Admins and campaign owners)
    match /campaigns/{campaignId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if (
        isAdmin() ||
        (isAuthenticated() && firestore.get(/databases/(default)/documents/campaigns/$(campaignId)).data.owner == request.auth.uid)
      ) && request.resource.size < 10 * 1024 * 1024;
    }

    // System uploads
    match /system/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}

{
  "version": 2,
  "rewrites": [
    {
      "source": "/(assets|favicon.svg|icons.svg|og-image.png|robots.txt|sitemap.xml|sitemap_index.xml)/(.*)",
      "destination": "/$1/$2"
    },
    {
      "source": "/(favicon.svg|icons.svg|og-image.png|robots.txt|sitemap.xml|sitemap_index.xml)",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
